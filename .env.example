# --- Core ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Manila

# --- Database ---
# Leave empty for SQLite (development). For production use PostgreSQL, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/bloodbank
DATABASE_URL=

# --- Security ---
SESSION_TIMEOUT_SECONDS=1800
FAILED_LOGIN_LIMIT=5
FAILED_LOGIN_LOCKOUT_SECONDS=900
PASSWORD_MIN_LENGTH=8

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.doc,.docx

# --- Email ---
# Default backend logs emails to console (DEVELOPMENT ONLY).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@bloodbank.local

# --- SMS ---
# "mock" = development-only provider that logs messages; NOT a live SMS service.
# Real providers (e.g. Semaphore, Twilio) require credentials + integration work.
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_NAME=BLOODBANK

# --- Provider selection ---
EMAIL_PROVIDER=django
