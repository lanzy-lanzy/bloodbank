# --- Core ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Manila

# --- Database ---
# Development default: the MySQL/MariaDB service bundled with XAMPP
# (start "MySQL" in the XAMPP Control Panel, then create the database once:
#   "C:\xampp\mysql\bin\mysql.exe" -u root -e "CREATE DATABASE IF NOT EXISTS bloodbank CHARACTER SET utf8mb4;"
# ). XAMPP's default root user has an empty password.
DB_ENGINE=mysql
DB_NAME=bloodbank
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=0
# DATABASE_URL overrides everything above when set (e.g. production Postgres):
# DATABASE_URL=postgres://user:password@host:5432/bloodbank
# Set DB_ENGINE=sqlite to use the file-based development database instead.
DATABASE_URL=

# --- Security ---
SESSION_TIMEOUT_SECONDS=1800
FAILED_LOGIN_LIMIT=5
FAILED_LOGIN_LOCKOUT_SECONDS=900
PASSWORD_MIN_LENGTH=8

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.doc,.docx

# --- Email ---
# Default backend logs emails to console (DEVELOPMENT ONLY).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@bloodbank.local

# --- SMS ---
# "mock" = development-only provider that logs messages; NOT a live SMS service.
# "semaphore" = live Semaphore API v4 (Philippines gateway). Requires SMS_API_KEY;
#               with an empty key every send fails safe (nothing is dispatched).
SMS_PROVIDER=mock
# Semaphore API key — never commit a real value. Get it from semaphore.co.
SMS_API_KEY=
# Registered sender name / number shown to recipients (empty = sender default).
SMS_SENDER_NAME=BLOODBANK
# Optional overrides for the Semaphore HTTP call.
SMS_API_URL=https://semaphore.co/api/v4/messages
SMS_TIMEOUT_SECONDS=10

# --- Provider selection ---
EMAIL_PROVIDER=django

# --- Printable documents ---
# Paper size for report print previews and PDF exports (A4 | LETTER | LEGAL).
# Wide reports (ledgers, bag listings) switch to landscape automatically.
REPORT_PAPER=A4
